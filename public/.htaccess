# ============================================================
# SN.DESIGN v4 - Apache config per Angular SSG
# Compressione + cache degli asset + sicurezza di base
# ============================================================

# --- Charset e MIME -----------------------------------------
AddDefaultCharset utf-8
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# --- Compressione (Brotli se disponibile, altrimenti gzip) --
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
  # I font woff2 e le immagini sono già compressi: non ricomprimerli
  SetEnvIfNoCase Request_URI \.(?:woff2?|png|jpe?g|webp|avif|ico)$ no-gzip
</IfModule>

# --- Cache --------------------------------------------------
# Gli asset con hash nel nome (main-XXXX.js, styles-XXXX.css) sono immutabili:
# cache lunga un anno. index.html e i file "vivi" sempre rivalidati.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Bundle con hash: immutabili
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML prerenderizzato: sempre fresco
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # File per crawler e agenti AI: rivalida ogni giorno
  <FilesMatch "^(robots\.txt|sitemap\.xml|llms\.txt|humans\.txt|ard\.json)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Sicurezza di base
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Routing ------------------------------------------------
# Sito SSG: / e /en/ esistono come file statici. Le rotte inesistenti
# devono restituire 404 (index.csr.html è il fallback client-side di Angular).
<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTP -> HTTPS. Il proxy di Aruba termina il TLS: controlla anche X-Forwarded-Proto.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # /en -> /en/ (slash finale, coerente con canonical e sitemap)
  RewriteRule ^en$ https://%{HTTP_HOST}/en/ [R=301,L]

  # Agenti che chiedono markdown (Accept: text/markdown): la home in markdown è llms.txt
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteRule ^(en/)?$ /llms.txt [E=MARKDOWN:1,L]

  # JS e CSS precompressi a brotli 11 (scripts/precompress.mjs), se il browser accetta br
  RewriteCond %{HTTP:Accept-Encoding} \bbr\b
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+\.(?:js|css))$ $1.br [L]

  # Home con un browser non in italiano: alla versione inglese. Solo se c'è Accept-Language
  # (Googlebot non lo manda, così / resta indicizzata) e se non si è scelto l'italiano dal
  # menu delle lingue (cookie lang=it, scritto dall'header).
  RewriteCond %{HTTP:Accept-Language} .
  RewriteCond %{HTTP:Accept-Language} !^it [NC]
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)lang=it(;|$)
  RewriteRule ^$ https://%{HTTP_HOST}/en/ [R=302,L]
</IfModule>

# La home cambia con lingua e cookie: le cache non devono servirla a tutti uguale.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(index\.html)?$#">
    Header always merge Vary "Accept-Language, Cookie"
  </If>
  # Home (it/en): risorse per gli agenti, e la risposta cambia con Accept (markdown).
  <If "%{REQUEST_URI} =~ m#^/(en/)?(index\.html)?$#">
    Header merge Vary Accept
    Header set Link "</llms.txt>; rel=\"alternate\"; type=\"text/markdown\", </.well-known/ard.json>; rel=\"ard\", </sitemap.xml>; rel=\"sitemap\""
  </If>
  # llms.txt servito al posto della home: dopo il rewrite la variabile prende il prefisso REDIRECT_
  Header set Content-Type "text/markdown; charset=utf-8" env=REDIRECT_MARKDOWN
  Header merge Vary Accept env=REDIRECT_MARKDOWN
  Header set Content-Type "text/markdown; charset=utf-8" env=MARKDOWN
  Header merge Vary Accept env=MARKDOWN
</IfModule>

# --- File .br serviti dalla regola sopra --------------------
# Tipo dell'originale, già compressi: niente compressione al volo.
<FilesMatch "\.js\.br$">
  ForceType text/javascript
</FilesMatch>
<FilesMatch "\.css\.br$">
  ForceType text/css
</FilesMatch>
<FilesMatch "\.(js|css)\.br$">
  SetEnv no-gzip 1
  SetEnv no-brotli 1
  <IfModule mod_headers.c>
    Header set Content-Encoding br
    Header merge Vary Accept-Encoding
    Header set Cache-Control "public, max-age=31536000, immutable"
  </IfModule>
</FilesMatch>

# --- Niente listing delle directory -------------------------
Options -Indexes
